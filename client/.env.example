# URL of the SignalR backend hub
# For local dev: https://localhost:7181/gamehub
# For production: https://api.yourdomain.com/gamehub
VITE_SIGNALR_URL=https://localhost:7181/gamehub

# Base URL path for the app (used by Vite at build time)
# Leave as "/" when using a custom domain on GitHub Pages
# Set to "/dot-war-game/" when deploying to https://<username>.github.io/dot-war-game/
VITE_BASE_URL=/
